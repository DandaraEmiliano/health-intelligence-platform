# Local development only. Copy to .env and change the values.
# Never reuse these values outside your machine. Real secrets come from a secret manager (Phase 7).

# PostgreSQL superuser (container bootstrap only)
POSTGRES_PASSWORD=change-me-postgres

# Per-service database roles (ADR 0005)
CORE_OWNER_PASSWORD=change-me-core-owner
CORE_APP_PASSWORD=change-me-core-app
AI_OWNER_PASSWORD=change-me-ai-owner
AI_APP_PASSWORD=change-me-ai-app

# Keycloak
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak-admin
KC_CORE_API_SERVICE_SECRET=change-me-core-api-service-secret
# Password of the synthetic users patient.a@example.test and patient.b@example.test (min. 12 chars)
KC_SYNTHETIC_USER_PASSWORD=change-me-synthetic-user

# Grafana (observability profile), user "admin"
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana

# Local S3/SQS emulators accept any credentials
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=sa-east-1
